node_modules/

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
*.env

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/

