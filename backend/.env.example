# Backend Environment Variables — MPSC Prep AI
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/mpscprepai"

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─── AI — Google Gemini (Phase 7: AI Extraction) ─────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
# Required for POST /api/admin/papers/:id/process to work.
# If not set, processing will fail with a clear error.
GEMINI_API_KEY=

# ─── Future variables (do NOT add real values here) ──────────────────────────
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
